# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored — never commit real tokens.

# Instagram Graph API — long-lived access token (see docs/INSTAGRAM_SETUP.md)
INSTAGRAM_ACCESS_TOKEN=
# Optional: numeric Instagram user id. Leave unset to use "me".
INSTAGRAM_USER_ID=

# Anthropic API key — used by `npm run generate:articles` to write SEO blog
# posts from each video. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
