# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored — never commit real tokens.

# Instagram Graph API — long-lived access token (see docs/INSTAGRAM_SETUP.md)
INSTAGRAM_ACCESS_TOKEN=
# Optional: numeric Instagram user id. Leave unset to use "me".
INSTAGRAM_USER_ID=

# Anthropic API key — used by `npm run generate:articles` to write SEO blog
# posts from each video. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Newsletter provider (Buttondown / Mailchimp / etc.) — not wired up yet,
# reserved for when a provider is chosen.
NEWSLETTER_API_KEY=

# --- Private dashboard (/dashboard) ---
# Pick any password — this is the only thing gating /dashboard.
DASHBOARD_PASSWORD=
# Optional: a separate random string for signing the login session cookie.
# Falls back to DASHBOARD_PASSWORD if unset — fine for personal use, but set
# your own (e.g. `openssl rand -hex 32`) before deploying.
DASHBOARD_SESSION_SECRET=
