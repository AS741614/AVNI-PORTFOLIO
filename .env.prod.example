# Copy to ".env.prod" on the server (never committed — same as every other
# secret in the co-hosted projects on this box).

# Any password — the only thing gating /dashboard.
DASHBOARD_PASSWORD=
# A random string for signing the login session cookie. Generate with:
#   openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# Optional — leave blank until wired up (site runs fine without them):
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
ANTHROPIC_API_KEY=
NEWSLETTER_API_KEY=
